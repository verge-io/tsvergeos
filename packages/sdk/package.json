{
	"name": "tsvergeos",
	"version": "0.1.0",
	"description": "TypeScript SDK for the VergeOS ultraconverged infrastructure platform",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./types": {
			"import": {
				"types": "./dist/types.d.ts",
				"default": "./dist/types.js"
			},
			"require": {
				"types": "./dist/types.d.cts",
				"default": "./dist/types.cjs"
			}
		},
		"./full": {
			"import": {
				"types": "./dist/full.d.ts",
				"default": "./dist/full.js"
			},
			"require": {
				"types": "./dist/full.d.cts",
				"default": "./dist/full.cjs"
			}
		},
		"./services/vm": {
			"import": {
				"types": "./dist/services/vm/index.d.ts",
				"default": "./dist/services/vm/index.js"
			},
			"require": {
				"types": "./dist/services/vm/index.d.cts",
				"default": "./dist/services/vm/index.cjs"
			}
		},
		"./services/network": {
			"import": {
				"types": "./dist/services/network/index.d.ts",
				"default": "./dist/services/network/index.js"
			},
			"require": {
				"types": "./dist/services/network/index.d.cts",
				"default": "./dist/services/network/index.cjs"
			}
		},
		"./services/machine-drive": {
			"import": {
				"types": "./dist/services/machine-drive/index.d.ts",
				"default": "./dist/services/machine-drive/index.js"
			},
			"require": {
				"types": "./dist/services/machine-drive/index.d.cts",
				"default": "./dist/services/machine-drive/index.cjs"
			}
		},
		"./services/machine-nic": {
			"import": {
				"types": "./dist/services/machine-nic/index.d.ts",
				"default": "./dist/services/machine-nic/index.js"
			},
			"require": {
				"types": "./dist/services/machine-nic/index.d.cts",
				"default": "./dist/services/machine-nic/index.cjs"
			}
		},
		"./services/machine-snapshot": {
			"import": {
				"types": "./dist/services/machine-snapshot/index.d.ts",
				"default": "./dist/services/machine-snapshot/index.js"
			},
			"require": {
				"types": "./dist/services/machine-snapshot/index.d.cts",
				"default": "./dist/services/machine-snapshot/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.0",
		"typescript": "^5.8.0",
		"undici": "^7.24.5",
		"vitest": "^4.1.0"
	},
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"keywords": [
		"vergeos",
		"verge",
		"sdk",
		"infrastructure",
		"hyperconverged"
	]
}
